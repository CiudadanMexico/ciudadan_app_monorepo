# Configuracion de ejemplo para scripts/fleet-status.mjs.
# Copia este archivo a scripts/fleet-status.env y ajústalo si cambia la flota.
# No se versionan llaves, tokens ni passwords: SSH_KEY puede apuntar a una ruta local.

# Usuario y direccion SSH de cada host OCI.
FLEET_SSH_USER=yizuz
FLEET_TEMPORAL_1_HOST=160.34.219.124
FLEET_TEMPORAL_2_HOST=163.192.153.145
FLEET_TEMPORAL_3_HOST=159.54.133.219

# Contenedores que se consultan en cada host.
FLEET_TEMPORAL_1_CONTAINERS="temporal1-agent1 temporal1-agent2 temporal1-agent3 temporal1-agent4"
FLEET_TEMPORAL_2_CONTAINERS="temporal2-agent1 temporal2-agent2 temporal2-agent3 temporal2-agent4 temporal2-agent5 temporal2-agent6"
FLEET_TEMPORAL_3_CONTAINERS="temporal3-agent1 temporal3-agent2 temporal3-agent3"

# Rutas y usuario dentro de cada contenedor.
FLEET_REPO_PATH=/workspace/ciudadan_app_monorepo
FLEET_DOCKER_USER=yizuz
FLEET_TMUX_SOCKET_TEMPLATE=/tmp/tmux-%s/default

# Metricas del host OCI y ventana del log de Docker.
FLEET_HOST_DISK_PATH=/
FLEET_LOG_TAIL=500

# Tiempos y verificacion de host key.
FLEET_SSH_CONNECT_TIMEOUT=10
FLEET_SSH_COMMAND_TIMEOUT=120000
FLEET_SSH_STRICT_HOST_KEY_CHECKING=accept-new

# Ruta opcional a la llave privada. Si se omite se usa
# ~/.ssh/id_ed25519 (o %USERPROFILE%\.ssh\id_ed25519 en Windows).
# SSH_KEY=/ruta/local/a/id_ed25519
