# Copy this file to .env (or .env.local) and fill in real values.
# Google OAuth 2.0 Web Client ID used to connect Google Drive with the
# minimal "drive.file" scope (Comunidad > Feed media storage, MVP).
REACT_APP_GOOGLE_CLIENT_ID=

# Production: the wiki API is served by socket-service at this public host.
# REACT_APP_SOCKET_URL remains the host for Socket.IO/other realtime features.
REACT_APP_WIKI_URL=https://socks.ciudadan.org

# Inauguración Ciudadan 6.0 (21-NOV-2026) — registro vía Luma.
# Obtener los valores reales en Luma: Manage Event > More > Embed.
# Se incrustan en el build: recompilar tras cambiarlos. Sin secretos aquí.
# REACT_APP_LUMA_EVENT_URL=https://lu.ma/EVENTO_REAL
# REACT_APP_LUMA_EMBED_URL=https://lu.ma/embed/event/evt-ID_REAL/simple
