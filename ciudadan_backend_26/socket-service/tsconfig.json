{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "."
  },
  "include": [
    "server.ts",
    "routes/**/*",
    "wiki/**/*",
    "services/**/*",
    "repository/**/*",
    "config/**/*",
    "config/**/*.sql"
  ]
}


