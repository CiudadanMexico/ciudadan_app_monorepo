# --- Servidor ---
HOST=0.0.0.0
PORT=1337
NODE_ENV=development
APP_KEYS=claves1,claves2,claves3,claves4
API_TOKEN_SALT=<salt>
ADMIN_JWT_SECRET=<secreto>
TRANSFER_TOKEN_SALT=<salt>
JWT_SECRET=<secreto>

# --- Base de datos ---
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# --- CORS ---
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# --- Auth0 (login real del backend) ---
AUTH0_DOMAIN=<tu-tenant>.us.auth0.com
AUTH0_AUDIENCE=<audience>

# --- Media API (Bloque 5B, server-to-server) ---
# URL privada tailnet de la Ciudadan Media API (Bloques 4D/5A).
# NO exponer al frontend; el token vive SOLO aqui (chmod 600).
CIUDADAN_MEDIA_API_URL=http://<ip-tailnet>:8090
CIUDADAN_MEDIA_API_TOKEN=<token-64-hex-del-cliente-ciudadan-backend>
MEDIA_USER_MAX_UPLOAD_BYTES=524288000
MEDIA_MAX_ACTIVE_LIGHT=3
MEDIA_MAX_ACTIVE_HEAVY=1
MEDIA_MAX_UPLOADS_PER_DAY=20
MEDIA_MAX_JOBS_PER_DAY=50
MEDIA_RATE_LIMIT_PER_MIN=60
