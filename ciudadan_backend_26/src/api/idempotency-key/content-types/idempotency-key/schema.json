{
  "kind": "collectionType",
  "collectionName": "idempotency_keys",
  "info": {
    "singularName": "idempotency-key",
    "pluralName": "idempotency-keys",
    "displayName": "Idempotency Key",
    "description": "Claves de idempotencia para evitar procesamiento duplicado de webhooks y operaciones críticas"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "unique": true,
      "maxLength": 100
    },
    "operation_type": {
      "type": "enumeration",
      "enum": [
        "payment_success",
        "payment_failure",
        "preapproval_update",
        "leader_commission",
        "leader_kit_purchase",
        "leader_shipment",
        "state_partner_entry_fee",
        "state_partner_commission",
        "driver_membership_payment",
        "commission"
      ],
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": ["processing", "completed", "failed"],
      "default": "processing",
      "required": true
    },
    "processed_at": {
      "type": "datetime",
      "required": true
    },
    "completed_at": {
      "type": "datetime"
    },
    "reference_id": {
      "type": "string",
      "maxLength": 100
    },
    "metadata": {
      "type": "json"
    },
    "error_message": {
      "type": "text"
    }
  }
}