{
  "kind": "collectionType",
  "collectionName": "shipments",
  "info": {
    "singularName": "shipment",
    "pluralName": "shipments",
    "displayName": "Shipment",
    "description": "Envíos de Skydropx para kits de líderes, Marketplace y otros"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "leader": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::leader.leader"
    },
    "pedido": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::pedido.pedido"
    },
    "shipping_quote": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::shipping-quote.shipping-quote"
    },
    "shipment_packages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::shipment-package.shipment-package",
      "mappedBy": "shipment"
    },
    "type": {
      "type": "enumeration",
      "enum": ["leader_kit", "marketplace_order", "standard"],
      "required": true
    },
    "skydropx_shipment_id": {
      "type": "string",
      "unique": true
    },
    "tracking_number": {
      "type": "string"
    },
    "label_url": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "rate_id": {
      "type": "string"
    },
    "address_from": {
      "type": "json"
    },
    "address_to": {
      "type": "json"
    },
    "packages": {
      "type": "json"
    },
    "metadata": {
      "type": "json"
    }
  }
}
