{
  "kind": "collectionType",
  "collectionName": "tareas",
  "info": {
    "singularName": "tarea",
    "pluralName": "tareas",
    "displayName": "tasks-completed",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "idx": {
      "type": "uid"
    },
    "agencia": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::agencia.agencia"
    },
    "tipo": {
      "type": "enumeration",
      "enum": [
        "tarea",
        "subtarea"
      ],
      "default": "tarea"
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "en_proceso",
        "completada",
        "corregir",
        "corregida",
        "calificada",
        "pagada",
        "cancelada",
        "modificada"
      ],
      "default": "en_proceso"
    },
    "media": {
      "type": "json",
      "description": "Array de evidencias adjuntas. Cada entry: { nombre, tipo, url, size, subido_por, subido_en }. Validado en subir-evidencia.js."
    },
    "notes": {
      "type": "text"
    },
    "score": {
      "type": "integer",
      "default": 0
    },
    "reviewed_by": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "resolved_at": {
      "type": "datetime"
    },
    "payment_status": {
      "type": "enumeration",
      "enum": [
        "pendiente",
        "procesado"
      ],
      "default": "pendiente"
    },
    "todo": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::todo.todo",
      "inversedBy": "tareas"
    },
    "avances": {
      "type": "json"
    },
    "usuario": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "enlaces": {
      "type": "json"
    },
    "calificaciones": {
      "type": "json"
    },
    "apelaciones": {
      "type": "json"
    },
    "pagos_laborys": {
      "type": "json"
    },
    "pagos_efectivo": {
      "type": "json"
    },
    "validaciones": {
      "type": "json"
    },
    "titulo": {
      "type": "string"
    },
    "descripcion": {
      "type": "text"
    }
  }
}
