{
  "kind": "collectionType",
  "collectionName": "food_carts",
  "info": {
    "singularName": "food-cart",
    "pluralName": "food-carts",
    "displayName": "Food Carts"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "usuario": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "items": {
      "displayName": "Food Cart Item",
      "type": "component",
      "repeatable": true,
      "component": "food-cart.food-cart-item"
    },
    "subtotal": {
      "type": "decimal"
    },
    "monto_envio": {
      "type": "decimal"
    },
    "monto_total": {
      "type": "decimal"
    },
    "moneda": {
      "type": "string",
      "default": "MXN"
    },
    "estado": {
      "type": "enumeration",
      "enum": [
        "activo",
        "procesando",
        "convertido",
        "abandonado"
      ],
      "default": "activo"
    },
    "ultima_actualizacion": {
      "type": "datetime"
    },
    "metadata": {
      "type": "json"
    }
  }
}
